<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ADAMessenger" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- V-5: Splash screen theme (applied in AndroidManifest, replaced in onCreate) -->
    <style name="Theme.ADAMessenger.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.ADAMessenger</item>
    </style>
</resources>
